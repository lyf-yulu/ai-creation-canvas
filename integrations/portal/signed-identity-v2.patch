+@app.api_route("/ai-canvas/", methods=["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"])
+@app.api_route("/ai-canvas/{canvas_path:path}", methods=["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"])
+async def proxy_ai_canvas(request: Request, canvas_path: str = "") -> Response:
+    """Authenticated, fixed-target proxy; it is not a general-purpose proxy."""
+    raw_path = request.scope.get("raw_path", b"")
+    target_path = "/" + canvas_path
+    if (
+        not isinstance(raw_path, bytes)
+        or b"%" in raw_path
+        or b"\\" in raw_path
+        or "//" in target_path
+        or "\\" in target_path
+        or target_path.startswith("/../")
+    ):
+        raise HTTPException(status_code=404)
+    user = authenticated_session(request)
+    secret = request.app.state.canvas_identity_secret
+    headers = {
+        name: value for name, value in request.headers.items()
+        if name.lower() not in IDENTITY_HEADERS
+        and name.lower() not in {"host", "connection", "content-length"}
+    }
+    headers.update(canvas_identity_headers(user, secret))
+    transport = getattr(request.app.state, "canvas_transport", None)
+    body = await request.body()
+    async with httpx.AsyncClient(
+        base_url=AI_CANVAS_ORIGIN,
+        transport=transport,
+        follow_redirects=False,
+        timeout=10.0,
+    ) as upstream:
+        response = await upstream.request(
+            request.method,
+            target_path,
+            params=request.query_params,
+            content=body,
+            headers=headers,
+        )
+    response_headers = {
+        name: value for name, value in response.headers.items()
+        if name.lower() not in {"connection", "transfer-encoding", "x-job-id"}
+    }
+    return Response(content=response.content, status_code=response.status_code, headers=response_headers)
