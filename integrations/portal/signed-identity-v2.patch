-from fastapi import FastAPI, HTTPException, Request
+import hashlib
+import hmac
+import time
+from urllib.parse import quote
+
+import httpx
+from fastapi import FastAPI, HTTPException, Request
+from starlette.responses import Response
+
+AI_CANVAS_MOUNT = "/ai-canvas"
+AI_CANVAS_ORIGIN = "http://127.0.0.1:8992"
+IDENTITY_HEADERS = frozenset({
+    "x-portal-sig-version", "x-portal-timestamp", "x-portal-user-id",
+    "x-portal-username", "x-portal-role", "x-portal-signature",
+})
+HOP_BY_HOP_HEADERS = frozenset({
+    "connection", "keep-alive", "proxy-authenticate", "proxy-authorization",
+    "te", "trailer", "transfer-encoding", "upgrade",
+})
+
+
+def _canvas_dependencies():
+    """Resolve the pinned Portal hooks once and fail closed if its shape drifts."""
+    auth_hook = globals().get("portal_authenticated_user")
+    secret = getattr(app.state, "portal_internal_token", None)
+    if not callable(auth_hook):
+        raise RuntimeError("AI Canvas requires Portal's portal_authenticated_user hook")
+    if not isinstance(secret, str) or len(secret) < 16:
+        raise RuntimeError("AI Canvas requires a configured Portal internal signing token")
+    return auth_hook, secret
+
+
+def _filtered_headers(headers, *, request: bool) -> dict[str, str]:
+    get_values = getattr(headers, "getlist", None) or getattr(headers, "get_list")
+    connection_tokens = {
+        token.strip().lower()
+        for value in get_values("connection")
+        for token in value.split(",")
+        if token.strip()
+    }
+    blocked = HOP_BY_HOP_HEADERS | connection_tokens
+    if request:
+        blocked |= IDENTITY_HEADERS | {"host", "content-length"}
+    return {
+        name: value
+        for name, value in headers.items()
+        if name.lower() not in blocked
+        and not (request and name.lower().startswith("x-portal-"))
+    }
+
+
+def _canvas_payload(timestamp: str, user_id: str, role: str, username: str) -> bytes:
+    return f"v2\n{timestamp}\n{user_id}\n{role}\n{quote(username, safe='')}".encode("utf-8")
+
+
+def _canvas_signature(secret: str, timestamp: str, user_id: str, role: str, username: str) -> str:
+    return hmac.new(secret.encode("utf-8"), _canvas_payload(timestamp, user_id, role, username), hashlib.sha256).hexdigest()
+
+
+def verify_canvas_identity(headers: dict[str, str], secret: str, *, now: int | None = None, max_age_seconds: int = 60) -> bool:
+    """Verify canonical, domain-separated v2 identity with a bounded clock window."""
+    try:
+        timestamp = str(int(headers["X-Portal-Timestamp"]))
+        user_id, role, username = headers["X-Portal-User-Id"], headers["X-Portal-Role"], headers["X-Portal-Username"]
+        signature = headers["X-Portal-Signature"]
+    except (KeyError, TypeError, ValueError):
+        return False
+    if not user_id or not role or not username or abs((int(time.time()) if now is None else now) - int(timestamp)) > max_age_seconds:
+        return False
+    return hmac.compare_digest(_canvas_signature(secret, timestamp, user_id, role, username), signature)
+
+
+def canvas_identity_headers(user: dict[str, str], secret: str) -> dict[str, str]:
+    """Use only Portal's authenticated session, never browser-provided identity."""
+    timestamp = str(int(time.time()))
+    return {
+        "X-Portal-Sig-Version": "2",
+        "X-Portal-Timestamp": timestamp,
+        "X-Portal-User-Id": user["user_id"],
+        "X-Portal-Username": user["username"],
+        "X-Portal-Role": user["role"],
+        "X-Portal-Signature": _canvas_signature(secret, timestamp, user["user_id"], user["role"], user["username"]),
+    }
@@ -20,2 +102,49 @@
 def healthz():
     return {'ok': True}
+
+
+async def _validate_canvas_dependencies() -> None:
+    _canvas_dependencies()
+
+
+app.router.on_startup.append(_validate_canvas_dependencies)
+
+
+@app.api_route("/ai-canvas/", methods=["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"])
+@app.api_route("/ai-canvas/{canvas_path:path}", methods=["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD", "OPTIONS"])
+async def proxy_ai_canvas(request: Request, canvas_path: str = "") -> Response:
+    """Authenticated, fixed-target proxy; it is not a general-purpose proxy."""
+    raw_path = request.scope.get("raw_path", b"")
+    target_path = "/" + canvas_path
+    if (
+        not isinstance(raw_path, bytes)
+        or b"%" in raw_path
+        or b"\\" in raw_path
+        or "//" in target_path
+        or "\\" in target_path
+        or target_path.startswith("/../")
+    ):
+        raise HTTPException(status_code=404)
+    auth_hook, secret = _canvas_dependencies()
+    user = auth_hook(request)
+    headers = _filtered_headers(request.headers, request=True)
+    headers.update(canvas_identity_headers(user, secret))
+    transport = getattr(request.app.state, "canvas_transport", None)
+    body = await request.body()
+    async with httpx.AsyncClient(
+        base_url=AI_CANVAS_ORIGIN,
+        transport=transport,
+        follow_redirects=False,
+        timeout=10.0,
+    ) as upstream:
+        response = await upstream.request(
+            request.method,
+            target_path,
+            params=request.query_params,
+            content=body,
+            headers=headers,
+        )
+    response_headers = _filtered_headers(response.headers, request=False)
+    response_headers.pop("x-job-id", None)
+    response_headers.pop("x-usage", None)
+    return Response(content=response.content, status_code=response.status_code, headers=response_headers)
