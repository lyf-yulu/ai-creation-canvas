{
  "services": [
    {
      "service_id": "image-service",
      "mount": "/image-service",
      "service_type": "image",
      "operations": ["image.generate", "image.edit"]
    },
    {
      "service_id": "video-service",
      "mount": "/video-service",
      "service_type": "video",
      "operations": ["video.generate", "video.image_to_video"]
    },
    {
      "service_id": "portrait-assets",
      "mount": "/portrait-assets",
      "service_type": "portrait_asset",
      "operations": ["video.image_to_video"]
    }
  ]
}
